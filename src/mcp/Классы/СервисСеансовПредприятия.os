#Использовать json
#Использовать 1commands

&Пластилин
Перем ДвижокКонфигуратор;

Перем _Управление;
Перем _Помощник;

&Желудь
Процедура ПриСозданииОбъекта()
	_Управление = Новый УправляемыйЗапускПредприятия;
	КаталогКласса = Новый Файл(ТекущийСценарий().Источник).Путь;
	_Помощник = Новый Файл(ОбъединитьПути(КаталогКласса, "../../../tools/enterprise-window.ps1")).ПолноеИмя;
КонецПроцедуры

Функция Запустить(Знач КаталогБазы, Знач Версия) Экспорт
	ПлатформаОС = НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы));
	Если НЕ СтрНачинаетсяС(ПлатформаОС, "windows") И НЕ СтрНачинаетсяС(ПлатформаОС, "macos") Тогда
		ВызватьИсключение "Управляемое окно предприятия пока поддерживается в Windows и macOS";
	КонецЕсли;
	Если СтрНайти(КаталогБазы, """") > 0 Или СтрНайти(КаталогБазы, Символы.ПС) > 0
		Или СтрНайти(КаталогБазы, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Недопустимый каталог базы";
	КонецЕсли;
	Абсолютный = (СтрДлина(КаталогБазы) > 2 И Сред(КаталогБазы, 2, 2) = ":\") Или СтрНачинаетсяС(КаталогБазы, "\\");
	Абсолютный = Абсолютный Или (СтрНачинаетсяС(ПлатформаОС, "macos") И СтрНачинаетсяС(КаталогБазы, "/"));
	Если НЕ Абсолютный Или НЕ Новый Файл(ОбъединитьПути(КаталогБазы, "1Cv8.1CD")).Существует() Тогда
		ВызватьИсключение "Требуется абсолютный путь существующей файловой базы с 1Cv8.1CD";
	КонецЕсли;
	Если НЕ Новый Файл(_Помощник).Существует() Тогда
		ВызватьИсключение "Не установлен помощник управления окном предприятия";
	КонецЕсли;
	Подключение = Новый Структура("СтрокаПодключения, Пользователь, Пароль", "/F""" + КаталогБазы + """", "", "");
	Платформа = Новый Структура("ВерсияПлатформы, КодРазрешения, Язык, Локаль", Версия, "", "", "");
	Запуск = Новый Структура("НеОжидать, РежимЗапуска, КомандаЗапуска, ПутьКФайлуСтатуса, ПутьОбработки, НавигационнаяСсылка, ДополнительныеПараметры",
		Истина, "0", "", "", "", "", "");
	План = ДвижокКонфигуратор.СформироватьЗапускПредприятия(Подключение, Запуск, Платформа);
	Контекст = Новый Структура("Вид, КаталогБазы, ПутьСтатуса", "enterprise", КаталогБазы, "");
	Возврат _Управление.Запустить(План.КоманднаяСтрока, Контекст);
КонецФункции

Функция НайтиПоЖурналу(Знач Путь) Экспорт
	Если СтрНайти(Путь, """") > 0 Или СтрНайти(Путь, Символы.ПС) > 0 Или СтрНайти(Путь, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Недопустимый путь журнала";
	КонецЕсли;
	Возврат _Управление.НайтиПоЖурналу(Путь);
КонецФункции

Функция Состояние(Знач Идентификатор) Экспорт
	Возврат _Управление.Состояние(Идентификатор);
КонецФункции

Функция СледующееСостояние(Знач Идентификатор, Знач Предыдущее) Экспорт
	Возврат _Управление.СледующееСостояние(Идентификатор, Предыдущее);
КонецФункции

Функция Восстановить(Знач Идентификатор) Экспорт
	Возврат _Управление.Восстановить(Идентификатор);
КонецФункции

Функция РазрешитьОбработке(Знач Идентификатор, Знач Возможность) Экспорт
	Возврат _Управление.РазрешитьОбработке(Идентификатор, Возможность);
КонецФункции

Функция ВыполнитьПодготовленный(Знач Идентификатор) Экспорт
	Возврат _Управление.ВыполнитьПодготовленный(Идентификатор);
КонецФункции

Функция Остановить(Знач Идентификатор, Знач Таймаут) Экспорт
	Возврат _Управление.Остановить(Идентификатор, Таймаут);
КонецФункции

Функция Отменить(Знач Идентификатор) Экспорт
	Возврат _Управление.Отменить(Идентификатор);
КонецФункции
