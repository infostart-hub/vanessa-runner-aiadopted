// BSLLS-off
// Юнит-тесты НастройкиVanessa: наложение --report-format/--report-path на настройки
// Vanessa-ADD (файл ключа запуска VBParams).
//
// Ключей запуска для отчётов у bddRunner нет, поэтому опции превращаются в настройки.

#Использовать asserts
#Использовать tempfiles
#Использовать "../../../src/core/Сервисы"
#Использовать "../../../src/core/Файлы"
#Использовать "../utils"

Перем Настройки;
Перем Каталоги;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Настройки = Новый НастройкиVanessa;
	Каталоги = Новый Массив;
КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт
	Для Каждого Каталог Из Каталоги Цикл
		Попытка
			УдалитьФайлы(Каталог);
		Исключение
			// не критично для теста
		КонецПопытки;
	КонецЦикла;
	ВременныеФайлы.Удалить();
КонецПроцедуры

#Область ДополнитьОтчетами

&Тест
Процедура ТестДолжен_ЗавершитьАвтоматическийПрогонБезОжиданияЧеловека() Экспорт
    Значения = Новый Массив; Значения.Добавить(Истина); Значения.Добавить("Истина");
    Для Каждого Включено Из Значения Цикл
        Исходные = Новый Соответствие;
        Исходные.Вставить("ОстановкаПриВозникновенииОшибки", Включено);
        Выключено = ?(ТипЗнч(Включено) = Тип("Булево"), Ложь, "Ложь");
        Исходные.Вставить("ЗавершитьРаботуСистемы", Выключено);
        Исходные.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", Выключено);
        Путь = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Исходные);
        Запуск = Настройки.ПодготовитьСтатусВыполнения(Путь, Истина);
        Результат = ТестовыеФайлы.ПрочитатьJSON(Запуск.ПутьНастроек);
        Ожидаем.Что(Результат.Получить("ВыполнитьСценарии")).Равно(Истина);
        Ожидаем.Что(Результат.Получить("ОстановкаПриВозникновенииОшибки")).Равно(?(ТипЗнч(Включено) = Тип("Булево"), Ложь, "Ложь"));
        Ожидаем.Что(Результат.Получить("ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев")).Равно(Запуск.ПутьСтатуса);
        Ожидаем.Что(Результат.Получить("ЗавершитьРаботуСистемы")).Равно(Включено);
        Ожидаем.Что(Результат.Получить("ЗакрытьTestClientПослеЗапускаСценариев")).Равно(Включено);
        Ожидаем.Что(ТестовыеФайлы.ПрочитатьJSON(Путь).Получить("ЗавершитьРаботуСистемы")).Равно(Выключено);
        Ожидаем.Что(ТестовыеФайлы.ПрочитатьJSON(Путь).Получить("ОстановкаПриВозникновенииОшибки")).Равно(Включено);
        Каталоги.Добавить(Запуск.ПутьНастроек);
        Каталоги.Добавить(Запуск.ПутьСтатуса);
    КонецЦикла;
КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьПаузуПриОшибкеВИнтерактивномПрогоне() Экспорт
    Исходные = Новый Соответствие; Исходные.Вставить("ОстановкаПриВозникновенииОшибки", Истина);
    Запуск = Настройки.ПодготовитьСтатусВыполнения(ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Исходные), Ложь);
    Ожидаем.Что(ТестовыеФайлы.ПрочитатьJSON(Запуск.ПутьНастроек).Получить("ОстановкаПриВозникновенииОшибки")).Равно(Истина);
    Каталоги.Добавить(Запуск.ПутьНастроек);
    Каталоги.Добавить(Запуск.ПутьСтатуса);
КонецПроцедуры


&Тест
Процедура ТестДолжен_ВернутьИсходныйПуть_БезОтчетов() Экспорт

	ПутьИсходных = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Новый Соответствие);

	Ожидаем.Что(Настройки.ДополнитьОтчетами(ПутьИсходных, Новый Массив), "путь настроек")
		.Равно(ПутьИсходных);
	Ожидаем.Что(Настройки.ДополнитьОтчетами(ПутьИсходных, Неопределено), "путь настроек")
		.Равно(ПутьИсходных);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьОтчетJUnit() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("junit", "build/junit"));

	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеjUnit"), "флаг jUnit").Равно("Истина");
	Ожидаем.Что(Результат.Получить("КаталогOutputjUnit"), "каталог jUnit").Равно("build/junit");

КонецПроцедуры

// У Allure нет флага «делать отчёт» - его включает сам каталог. Подкаталог сборки
// выключаем, иначе результат уезжает в непредсказуемый путь и CI не знает, что публиковать.
&Тест
Процедура ТестДолжен_ВключитьОтчетAllure_БезПодкаталогаСборки() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("allure", "build/allure"));
	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеАллюр")).Равно(Истина);

	Ожидаем.Что(Результат.Получить("КаталогOutputAllureБазовый"), "базовый каталог").Равно("build/allure");
	Ожидаем.Что(Результат.Получить("КаталогOutputAllure"), "каталог").Равно("build/allure");
	Ожидаем.Что(Результат.Получить("СоздаватьПодкаталогВКаталогеAllureДляЭтойСборки"), "подкаталог сборки")
		.Равно("Ложь");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьОтчетCucumberJson() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("cucumberjson", "build/cucumber"));

	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеCucumberJson"), "флаг Cucumber").Равно("Истина");
	Ожидаем.Что(Результат.Получить("КаталогOutputCucumberJson"), "каталог Cucumber").Равно("build/cucumber");

КонецПроцедуры

// Настройки пользователя - основа, а не помеха: всё, чего мы не трогаем, доезжает до ADD.
&Тест
Процедура ТестДолжен_СохранитьПользовательскиеНастройки() Экспорт

	Исходные = Новый Соответствие;
	Исходные.Вставить("ИмяСборки", "Тестовая сборка");
	Исходные.Вставить("ЗакрытьTestClientПослеЗапускаСценариев", "Истина");
	ПутьИсходных = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Исходные);

	Результат = ПрочитатьРезультат(ПутьИсходных, Отчеты("junit", "build/junit"));

	Ожидаем.Что(Результат.Получить("ИмяСборки"), "имя сборки").Равно("Тестовая сборка");
	Ожидаем.Что(Результат.Получить("ЗакрытьTestClientПослеЗапускаСценариев"), "закрытие клиента")
		.Равно("Истина");
	Ожидаем.Что(Результат.Получить("КаталогOutputjUnit"), "каталог jUnit").Равно("build/junit");

КонецПроцедуры

// Опция командной строки должна выигрывать у одноимённой настройки, иначе она
// бесполезна: --vanessasettings есть почти в каждом проекте.
&Тест
Процедура ТестДолжен_ПерекрытьКаталогИзНастроек() Экспорт

	Исходные = Новый Соответствие;
	Исходные.Вставить("КаталогOutputjUnit", "$workspaceRoot/./ServiceBases/junitreport");
	ПутьИсходных = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Исходные);

	Результат = ПрочитатьРезультат(ПутьИсходных, Отчеты("junit", "build/junit"));

	Ожидаем.Что(Результат.Получить("КаталогOutputjUnit"), "каталог jUnit").Равно("build/junit");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПереписыватьИсходныйФайл() Экспорт

	Исходные = Новый Соответствие;
	Исходные.Вставить("ИмяСборки", "Тестовая сборка");
	ПутьИсходных = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Исходные);

	ПутьРезультата = Настройки.ДополнитьОтчетами(ПутьИсходных, Отчеты("junit", "build/junit"));

	Ожидаем.Что(ПутьРезультата = ПутьИсходных, "результат пишется в отдельный файл").ЭтоЛожь();
	Ожидаем.Что(ТестовыеФайлы.ПрочитатьJSON(ПутьИсходных).Получить("КаталогOutputjUnit") = Неопределено,
		"исходный файл не тронут").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СобратьНастройкиСНуля_БезФайлаПользователя() Экспорт

	Результат = ПрочитатьРезультат("", Отчеты("junit", "build/junit"));

	Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеjUnit"), "флаг jUnit").Равно("Истина");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНесуществующемФайлеНастроек() Экспорт

	Ожидаем.Что(Настройки).Метод("ДополнитьОтчетами", ТестовыеДанные.Массив("нет-такого-файла.json", Отчеты("junit", "build/junit")))
		.ВыбрасываетИсключение("не найден");

КонецПроцедуры

&Тест
Процедура ТестДолжен_УпастьНаНеизвестномФормате() Экспорт

	Ожидаем.Что(Настройки).Метод("ДополнитьОтчетами", ТестовыеДанные.Массив("", Отчеты("mxl", "build/mxl")))
		.ВыбрасываетИсключение("mxl");

КонецПроцедуры

#КонецОбласти

&Тест
Процедура ТестДолжен_ПодготовитьКлиентаИзАктивногоПрофиля() Экспорт
	Профиль = Новый Структура("Имя, ТипКлиента, ИмяКомпьютера, ПортЗапускаТестКлиента, ПутьКИнфобазе, ДопПараметры, АктивизироватьСтроку",
		"desktop", "Тонкий", "localhost", 48123, "/FC:\example\ib", "/L ru", Истина);
	Профили = Новый Массив; Профили.Добавить(Профиль);
	Данные = Новый Структура("КлиентыТестирования", Профили);
	Клиент = Настройки.ПодготовитьКлиентаТестирования(ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Данные));
	Ожидаем.Что(Клиент.Подключение.СтрокаПодключения).Равно("/FC:\example\ib");
	Ожидаем.Что(Клиент.Запуск.ДополнительныеПараметры).Равно("/TESTCLIENT -TPort 48123 /L ru");
	Ожидаем.Что(Клиент.Запуск.ПутьОбработки).Равно("");
	Ожидаем.Что(Клиент.Запуск.КомандаЗапуска).Равно("");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтказатьПодготовкеБезЯвногоПрофиля() Экспорт
	Отказ = Ложь;
	Попытка
		Настройки.ПодготовитьКлиентаТестирования(ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Новый Структура));
	Исключение
		Отказ = Истина;
		Ожидаем.Что(ОписаниеОшибки()).Содержит("КлиентыТестирования");
	КонецПопытки;
	Ожидаем.Что(Отказ).Равно(Истина);
КонецПроцедуры



#Область СлужебныеПроцедурыИФункции

Функция Отчеты(Знач Формат, Знач Путь)
	Возврат ТестовыеДанные.Массив(Новый Структура("Формат, Путь", Формат, Путь));
КонецФункции

Функция ПрочитатьРезультат(Знач ПутьИсходных, Знач СписокОтчетов)
	Возврат ТестовыеФайлы.ПрочитатьJSON(Настройки.ДополнитьОтчетами(ПутьИсходных, СписокОтчетов));
КонецФункции

#КонецОбласти

&Тест
Процедура ТестДолжен_ПередатьFeatureИБиблиотекиВНастройкиAutomation() Экспорт
    Фича = ВременныеФайлы.НовоеИмяФайла("feature");
    Запись = Новый ЗаписьТекста(Фича); Запись.ЗаписатьСтроку("# language: ru"); Запись.Закрыть();
    Рабочий = Новый Файл(Фича).Путь;
    Библиотеки = Новый Массив; Библиотеки.Добавить(Рабочий);
    Путь = Настройки.ДополнитьСценарием("", Новый Файл(Фича).Имя, Библиотеки, Рабочий);
    Результат = ТестовыеФайлы.ПрочитатьJSON(Путь);
    Ожидаем.Что(Результат.Получить("КаталогФич")).Равно(Фича);
    Ожидаем.Что(Результат.Получить("КаталогиБиблиотек")[0]).Равно(Рабочий);
    Каталоги.Добавить(Путь);
КонецПроцедуры

&Тест
Процедура ТестДолжен_НаследоватьНастройкиСтендаБезИзмененияФайлов() Экспорт
    База = Новый Соответствие; База.Вставить("ИспользоватьКомпонентуVanessaExt", Ложь); База.Вставить("КаталогФич", "base");
    Свои = Новый Соответствие; Свои.Вставить("КаталогФич", "custom");
    БазовыйПуть = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), База);
    СвойПуть = ТестовыеФайлы.ЗаписатьJSON(ВременныеФайлы.НовоеИмяФайла("json"), Свои);
    Путь = Настройки.ДополнитьСценарием(СвойПуть, "", Неопределено, ".", БазовыйПуть);
    Результат = ТестовыеФайлы.ПрочитатьJSON(Путь);
    Ожидаем.Что(Результат.Получить("КаталогФич")).Равно("custom");
    Ожидаем.Что(Результат.Получить("ИспользоватьКомпонентуVanessaExt")).Равно(Ложь);
    Ожидаем.Что(ТестовыеФайлы.ПрочитатьJSON(БазовыйПуть).Получить("КаталогФич")).Равно("base");
    Каталоги.Добавить(Путь);
КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьСвежиеКаталогиОтчетовУправляемогоПрогона() Экспорт
    Запуск = Настройки.ПодготовитьСтатусВыполнения("", Истина);
    Результат = ТестовыеФайлы.ПрочитатьJSON(Запуск.ПутьНастроек);
    Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеjUnit")).Равно(Истина);
    Ожидаем.Что(Результат.Получить("ДелатьОтчетВФорматеАллюр")).Равно(Истина);
    Ожидаем.Что(Новый Файл(Результат.Получить("КаталогOutputjUnit")).Существует()).Равно(Истина);
    Ожидаем.Что(Новый Файл(Результат.Получить("КаталогOutputAllureБазовый")).Существует()).Равно(Истина);
    Каталоги.Добавить(Новый Файл(Запуск.ПутьНастроек).Путь);
КонецПроцедуры
