Перем _Имя;
Перем _Сервис;

Процедура ПриСозданииОбъекта(Знач Имя, Сервис)
	_Имя = Имя;
	_Сервис = Сервис;
КонецПроцедуры

Функция ИмяИнструмента() Экспорт
	Возврат _Имя;
КонецФункции

Функция ОписаниеИнструмента() Экспорт
	Если _Имя = "enterprise_find" Тогда
		Возврат "Прочитать нативный подготовленный запуск по точному абсолютному scenarioLog в его параметрах Vanessa. Требуется ровно одно совпадение. Возвращает runId, фактическое состояние и launchDiscovery с исходным путём. Не запускает процессы, не принимает сценарии и не доказывает освобождение ресурсов.";
	КонецЕсли;
	Если _Имя = "run_enterprise" Тогда
		Возврат "Открыть существующую файловую базу Windows в предприятии. Возвращает runId и состояние starting; PID и окно проверяются через enterprise_status. Клиент, завершившийся до появления окна, даёт result=failed с failureReason=exited_before_window и lastPlatformError из журнала регистрации базы. База не создаётся и не очищается.";
	ИначеЕсли _Имя = "enterprise_stop" Тогда
		Возврат "Запросить штатное закрытие собственных клиентов, затем менеджера по runId. close_pending требует дальнейшего наблюдения; processes содержит принятие запроса, заголовки окон и responding. Принудительного завершения нет.";
	КонецЕсли;
	Если _Имя = "enterprise_authorize" Тогда
		Возврат "Явно разрешить одну возможность точной обработки /Execute в собственном живом запуске Vanessa. capability: open_processing или administer_users. Проверяет нативную группу, менеджер, цепочку HWND, полный путь EPF и точный текст предупреждения. Возвращает requested либо acknowledgement_requested, квитанцию ввода и требование повторить прерванное действие; успешность сценариев доказывается отдельно. Политику безопасности платформы не отключает.";
	КонецЕсли;
	Если _Имя = "enterprise_execute" Тогда
		Возврат "Запустить сценарии подготовленного test_vanessa --prepare по прежнему runId. Контракт prepared-window/v2: требует executionPhase=ready, собственное окно и слушающий порт того же TestClient. Повтор не запускает второй менеджер. Вызывающий владелец сначала подтверждает запись окна.";
	КонецЕсли;
	Если _Имя = "enterprise_cancel" Тогда
		Возврат "Явно отменить собственный запуск по runId: принудительно завершить только его наблюдаемую группу процессов этого запуска (Windows Job или POSIX process group). Не вызывает штатное закрытие и не перезагружает компьютер. Возвращает result=failed, scenarioStatus=unknown, cleanupStatus=exited и cancellationProof с подтверждённым activeProcessCount=0. Не является успешным выполнением тестов.";
	КонецЕсли;
	Если _Имя = "enterprise_recover" Тогда
		Возврат "Восстановить наблюдение прежнего runId, без повторного запуска 1С. Именованная группа восстанавливает наблюдение; потерянная группа требует подтверждения выхода собственных идентификаторов и освобождения файла базы. resources_released даёт cleanupStatus=released, activeProcessCount=null, result=failed, scenarioStatus=unknown. Это освобождение ресурса для нового плана, не успех сценария. Живые собственные процессы или занятая база блокируют освобождение. Перезагрузка Windows не требуется.";
	КонецЕсли;
	Если _Имя = "enterprise_await" Тогда
		Возврат "Дождаться следующего состояния сохранённого runId: вызов отвечает, когда состояние запуска изменилось относительно переданного previous, либо сразу, если запуск уже завершён. Наблюдатель переписывает своё состояние при каждом изменении, поэтому ожидание не опрашивает запуск по часам и не имеет предельного срока.";
	КонецЕсли;
	Возврат "Проверить сохранённый runId: процессы, окна, scenarioStatus, cleanupStatus, result и failureReason (bad_exit, exited_before_window, scenario_<статус>); при exited_before_window поле lastPlatformError содержит последнюю ошибку журнала регистрации базы. executionDesktop содержит фактическую доступность ввода рабочего стола Windows; execution_desktop_unavailable означает отказ конкретного действия ввода, не необходимость перезагрузки. Доступен после переподключения MCP на этом компьютере под тем же пользователем.";
КонецФункции

Функция АннотацииИнструмента() Экспорт
	Возврат Новый Структура("readOnlyHint, destructiveHint, idempotentHint, openWorldHint",
		_Имя = "enterprise_status" Или _Имя = "enterprise_await" Или _Имя = "enterprise_find", _Имя = "enterprise_stop" Или _Имя = "enterprise_cancel",
		_Имя <> "run_enterprise", Истина);
КонецФункции

Функция СхемаИнструмента() Экспорт
	Свойства = Новый Соответствие;
	Обязательные = Новый Массив;
	Если _Имя = "enterprise_find" Тогда
		Свойства.Вставить("scenarioLog", Поле("string", "Точный абсолютный путь журнала сценариев, переданный в параметры этого запуска."));
		Обязательные.Добавить("scenarioLog");
	ИначеЕсли _Имя = "run_enterprise" Тогда
		Свойства.Вставить("ibpath", Поле("string", "Абсолютный каталог существующей файловой базы (1Cv8.1CD)."));
		Свойства.Вставить("v8version", Поле("string", "Установленная версия платформы 1С."));
		Обязательные.Добавить("ibpath");
		Обязательные.Добавить("v8version");
	Иначе
		Свойства.Вставить("runId", Поле("string", "UUID из run_enterprise/enterprise_find либо заданный test_vanessa --run-id до отправки."));
		Обязательные.Добавить("runId");
		Если _Имя = "enterprise_authorize" Тогда
			Возможность = Поле("string", "Явно разрешаемая возможность обработки для этого запуска.");
			Значения = Новый Массив; Значения.Добавить("open_processing"); Значения.Добавить("administer_users");
			Возможность.Вставить("enum", Значения);
			Свойства.Вставить("capability", Возможность);
			Обязательные.Добавить("capability");
		КонецЕсли;
		Если _Имя = "enterprise_await" Тогда
			Свойства.Вставить("previous", Поле("string",
				"Непрозрачный observationId последней квитанции enterprise_status/enterprise_await. Вызов возвращает следующую квитанцию, включая изменения процессов и окон без изменения итогового статуса."));
			Обязательные.Добавить("previous");
		КонецЕсли;
		Если _Имя = "enterprise_stop" Тогда
			Таймаут = Поле("integer", "Ожидание штатного выхода, секунды (по умолчанию 5). При таймауте процесс остаётся работать.");
			Таймаут.Вставить("minimum", 0);
			Таймаут.Вставить("maximum", 30);
			Свойства.Вставить("timeoutSeconds", Таймаут);
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("type, properties, required, additionalProperties", "object", Свойства, Обязательные, Ложь);
КонецФункции

Функция ВыполнитьИнструмент(Инструмент, Аргументы) Экспорт
	Если Аргументы = Неопределено Тогда
		ВызватьИсключение "Требуются аргументы инструмента";
	КонецЕсли;
	Схема = СхемаИнструмента();
	Для Каждого КЗ Из Аргументы Цикл
		Если Схема.properties.Получить(КЗ.Ключ) = Неопределено Тогда
			ВызватьИсключение "Неизвестный параметр инструмента";
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из Схема.required Цикл
		// JSON распознаёт UUID; поля схемы остаются строками,
		// включая runId и непрозрачный observationId в previous.
		Если ТипЗнч(Аргументы.Получить(Имя)) = Тип("УникальныйИдентификатор") Тогда
			Аргументы.Вставить(Имя, Строка(Аргументы.Получить(Имя)));
		КонецЕсли;
		Если ТипЗнч(Аргументы.Получить(Имя)) <> Тип("Строка") Или НЕ ЗначениеЗаполнено(Аргументы.Получить(Имя)) Тогда
			ВызватьИсключение "Требуется непустая строка: " + Имя;
		КонецЕсли;
	КонецЦикла;
	Если _Имя = "enterprise_find" Тогда
		Возврат _Сервис.НайтиПоЖурналу(Аргументы.Получить("scenarioLog"));
	ИначеЕсли _Имя = "run_enterprise" Тогда
		Возврат _Сервис.Запустить(Аргументы.Получить("ibpath"), Аргументы.Получить("v8version"));
	ИначеЕсли _Имя = "enterprise_authorize" Тогда
		Если Аргументы.Получить("capability") <> "open_processing" И Аргументы.Получить("capability") <> "administer_users" Тогда
			ВызватьИсключение "Неизвестная возможность обработки";
		КонецЕсли;
		Возврат _Сервис.РазрешитьОбработке(Аргументы.Получить("runId"), Аргументы.Получить("capability"));
	ИначеЕсли _Имя = "enterprise_execute" Тогда
		Возврат _Сервис.ВыполнитьПодготовленный(Аргументы.Получить("runId"));
	ИначеЕсли _Имя = "enterprise_status" Тогда
		Возврат _Сервис.Состояние(Аргументы.Получить("runId"));
	ИначеЕсли _Имя = "enterprise_recover" Тогда
		Возврат _Сервис.Восстановить(Аргументы.Получить("runId"));
	ИначеЕсли _Имя = "enterprise_cancel" Тогда
		Возврат _Сервис.Отменить(Аргументы.Получить("runId"));
	ИначеЕсли _Имя = "enterprise_await" Тогда
		Возврат _Сервис.СледующееСостояние(Аргументы.Получить("runId"), Аргументы.Получить("previous"));
	КонецЕсли;
	Таймаут = Аргументы.Получить("timeoutSeconds");
	Если Таймаут = Неопределено Тогда Таймаут = 5; КонецЕсли;
	Если ТипЗнч(Таймаут) <> Тип("Число") Или Таймаут < 0 Или Таймаут > 30 Или Цел(Таймаут) <> Таймаут Тогда
		ВызватьИсключение "timeoutSeconds должен быть целым числом от 0 до 30";
	КонецЕсли;
	Возврат _Сервис.Остановить(Аргументы.Получить("runId"), Таймаут);
КонецФункции

Функция Поле(Знач ТипПоля, Знач Описание)
	Возврат Новый Структура("type, description", ТипПоля, Описание);
КонецФункции
