// BSLLS-off
// Юнит-тесты супервизора сеансов предприятия (tools/enterprise-window.ps1) и описаний его MCP-инструментов.
// Вердикт сеанса вычисляется в PowerShell, поэтому его регрессия (tests/unit/enterprise-lifecycle.ps1)
// запускается отсюда, чтобы входить в общий гейт oneunit, а не жить отдельной командой из документации.

#Использовать asserts
#Использовать 1commands

#Использовать "../../../src/mcp"

#Область СупервизорОкнаПредприятия

&Тест
Процедура ТестДолжен_ПройтиРегрессиюСупервизораОкнаПредприятия() Экспорт

	// Дано
	Если НЕ ЭтоWindows() Тогда
		Сообщить("Супервизор окна предприятия поддерживается только в Windows; регрессия не выполняется");
		Возврат;
	КонецЕсли;
	КореньПроекта = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
	Помощник = ОбъединитьПути(КореньПроекта, "tools", "enterprise-window.ps1");
	Регрессия = ОбъединитьПути(КореньПроекта, "tests", "unit", "enterprise-lifecycle.ps1");

	Команда = Новый Команда;
	Команда.УстановитьКоманду("powershell");
	Команда.УстановитьРабочийКаталог(КореньПроекта);
	Команда.ДобавитьПараметр("-NoProfile");
	Команда.ДобавитьПараметр("-NonInteractive");
	Команда.ДобавитьПараметр("-ExecutionPolicy");
	Команда.ДобавитьПараметр("Bypass");
	Команда.ДобавитьПараметр("-File");
	Команда.ДобавитьПараметр(Регрессия);
	Команда.ДобавитьПараметр("-Helper");
	Команда.ДобавитьПараметр(Помощник);

	// Когда
	КодВозврата = Команда.Исполнить();

	// Тогда
	Ожидаем.Что(КодВозврата, Команда.ПолучитьВывод()).Равно(0);
	Ожидаем.Что(Команда.ПолучитьВывод()).Содержит("PASS:");
	Ожидаем.Что(Команда.ПолучитьВывод()).Содержит("silent enterprise exit fails with its platform error");

КонецПроцедуры

#КонецОбласти

#Область ОписанияИнструментов

&Тест
Процедура ТестДолжен_ОписатьПричинуОтказаВСтатусеСеанса() Экспорт

	// Дано
	Статус = Новый MCPИнструментПредприятия("enterprise_status", Неопределено);
	Запуск = Новый MCPИнструментПредприятия("run_enterprise", Неопределено);

	// Когда
	ОписаниеСтатуса = Статус.ОписаниеИнструмента();
	ОписаниеЗапуска = Запуск.ОписаниеИнструмента();

	// Тогда
	Ожидаем.Что(ОписаниеСтатуса).Содержит("failureReason");
	Ожидаем.Что(ОписаниеСтатуса).Содержит("exited_before_window");
	Ожидаем.Что(ОписаниеСтатуса).Содержит("lastPlatformError");
	Ожидаем.Что(ОписаниеЗапуска).Содержит("exited_before_window");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъявитьЯвноеВосстановлениеБезПовторногоЗапуска() Экспорт
	Инструмент = Новый MCPИнструментПредприятия("enterprise_recover", Неопределено);
	Схема = Инструмент.СхемаИнструмента();
	Ожидаем.Что(Схема.required.Количество()).Равно(1);
	Ожидаем.Что(Схема.required[0]).Равно("runId");
	Ожидаем.Что(Схема.additionalProperties).Равно(Ложь);
	Ожидаем.Что(Инструмент.АннотацииИнструмента().idempotentHint).Равно(Истина);
	Ожидаем.Что(Инструмент.АннотацииИнструмента().readOnlyHint).Равно(Ложь);
	Ожидаем.Что(Инструмент.ОписаниеИнструмента()).Содержит("без повторного запуска 1С");
КонецПроцедуры

#КонецОбласти

Функция ЭтоWindows()
	Возврат СтрНачинаетсяС(Строка(Новый СистемнаяИнформация().ТипПлатформы), "Windows");
КонецФункции

&Тест
Процедура ТестДолжен_СохранитьNullВКвитанцииMCP() Экспорт
    Движок = Новый УправляемыйЗапускПредприятия;
    Данные = Движок.РазобратьСостояние("{""activeProcessCount"":null,""empty"":"""",""zero"":0,""processes"":[{""exitCode"":null}],""proof"":{""exclusiveAccess"":true}}");
    Ожидаем.Что(ТипЗнч(Данные.Получить("activeProcessCount"))).Равно(Тип("Null"));
    Ожидаем.Что(Данные.Получить("empty")).Равно("");
    Ожидаем.Что(Данные.Получить("zero")).Равно(0);
    Ожидаем.Что(ТипЗнч(Данные.Получить("processes")[0].Получить("exitCode"))).Равно(Тип("Null"));
    Ответ = Новый ПарсерJSON().ЗаписатьJSON(Данные, Ложь);
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Ответ);
    Получено = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Ожидаем.Что(Получено.Получить("activeProcessCount")).Равно(Неопределено);
    Ожидаем.Что(Получено.Получить("empty")).Равно("");
    Ожидаем.Что(Получено.Получить("zero")).Равно(0);
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтделитьЯвнуюОтменуОтШтатногоЗакрытия() Экспорт
    Отмена = Новый MCPИнструментПредприятия("enterprise_cancel", Неопределено);
    Схема = Отмена.СхемаИнструмента();
    Ожидаем.Что(Схема.required.Количество()).Равно(1);
    Ожидаем.Что(Схема.required[0]).Равно("runId");
    Ожидаем.Что(Схема.properties.Количество()).Равно(1);
    Ожидаем.Что(Отмена.АннотацииИнструмента().destructiveHint).Равно(Истина);
    Ожидаем.Что(Отмена.ОписаниеИнструмента()).Содержит("result=failed");
    Закрытие = Новый MCPИнструментПредприятия("enterprise_stop", Неопределено);
    Ожидаем.Что(Закрытие.ОписаниеИнструмента()).Содержит("Принудительного завершения нет");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбъявитьВыполнениеПодготовленногоОкна() Экспорт
	Инструмент = Новый MCPИнструментПредприятия("enterprise_execute", Неопределено);
	Схема = Инструмент.СхемаИнструмента();
	Ожидаем.Что(Схема.required.Количество()).Равно(1);
	Ожидаем.Что(Схема.required[0]).Равно("runId");
	Ожидаем.Что(Схема.additionalProperties).Равно(Ложь);
	Ожидаем.Что(Инструмент.АннотацииИнструмента().readOnlyHint).Равно(Ложь);
	Ожидаем.Что(Инструмент.ОписаниеИнструмента()).Содержит("executionPhase=ready");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтделитьРазрешениеОбработкиОтЗапускаИСценарногоВердикта() Экспорт
    Инструмент = Новый MCPИнструментПредприятия("enterprise_authorize", Неопределено);
    Схема = Инструмент.СхемаИнструмента();
    Ожидаем.Что(Схема.required.Количество()).Равно(2);
    Ожидаем.Что(Схема.additionalProperties).Равно(Ложь);
    Возможность = Схема.properties.Получить("capability");
    Ожидаем.Что(Возможность.enum.Количество()).Равно(2);
    Ожидаем.Что(Инструмент.АннотацииИнструмента().readOnlyHint).Равно(Ложь);
    Ожидаем.Что(Инструмент.ОписаниеИнструмента()).Содержит("requested");
    Аргументы = Новый Соответствие;
    Аргументы.Вставить("runId", "11111111-1111-1111-1111-111111111111");
    Аргументы.Вставить("capability", "disable_security");
    Сообщение = "";
    Попытка
        Инструмент.ВыполнитьИнструмент(Неопределено, Аргументы);
    Исключение
        Сообщение = ОписаниеОшибки();
    КонецПопытки;
    Ожидаем.Что(Сообщение).Содержит("Неизвестная возможность обработки");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПройтиРегрессиюСупервизораMacOS() Экспорт
    Если НЕ СтрНачинаетсяС(НРег(Строка(Новый СистемнаяИнформация().ТипПлатформы)), "macos") Тогда Возврат; КонецЕсли;
    Корень = Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..", "..")).ПолноеИмя;
    Команда = Новый Команда;
    Команда.УстановитьКоманду("python3");
    Команда.ДобавитьПараметр("-m unittest discover -s tests/native -p ""test_macos*.py""");
    Команда.УстановитьРабочийКаталог(Корень);
    Команда.УстановитьПравильныйКодВозврата(0);
    Ожидаем.Что(Команда.Исполнить(), Команда.ПолучитьВывод()).Равно(0);
КонецПроцедуры
