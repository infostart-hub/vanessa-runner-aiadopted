// Точка входа MCP-сервера vrunner (stdio).
// Состав #Использовать - как в main.os: MCP-инструменты test_* принимают --coverage-report,
// поэтому пакет Покрытие нужен и здесь.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-cli
#Использовать autumn-mcpify
#Использовать tempfiles
#Использовать "./core/Файлы"
#Использовать "./core/Процессы"
#Использовать "./core/Движки"
#Использовать "./core/Покрытие"
#Использовать "./core/Сервисы"
#Использовать "./core/Приложение"
#Использовать "./core/Настройки"
#Использовать "./cli"
#Использовать "./mcp"

// MCP logs are emitted while the application context is being constructed.
// Initialize protocol encoding before those first notifications as well.
Консоль.КодировкаВходногоПотока = "UTF-8";
Консоль.КодировкаВыходногоПотока = "UTF-8";
Запуск = Новый MCP_Запуск();
// Фоновый worker использует тот же runtime, что уже запустил MCP.
// PATH клиента может содержать oscript.cmd, но не oscript.exe.
СведенияОСистеме = Новый СистемнаяИнформация;
ИмяИсполняемогоФайла = ?(СтрНачинаетсяС(Строка(СведенияОСистеме.ТипПлатформы), "Windows"),
    "oscript.exe", "oscript");
ПутьИсполняемогоФайла = ОбъединитьПути(КаталогПрограммы(), ИмяИсполняемогоФайла);
Если НЕ Новый Файл(ПутьИсполняемогоФайла).Существует() Тогда
    ВызватьИсключение "Не найден исполняемый файл текущего OneScript: " + ПутьИсполняемогоФайла;
КонецЕсли;
Запуск.Конфигурация().УстановитьПутьOscript(ПутьИсполняемогоФайла);
// Разные MCP-процессы имеют одинаковые taskId-счётчики. Их логи не должны пересекаться.
Запуск.Конфигурация().УстановитьКаталогЗадач(ОбъединитьПути(КаталогВременныхФайлов(),
    "autumn-mcpify-tasks", Строка(Новый УникальныйИдентификатор)));
Запуск.Старт();

ВременныеФайлы.Удалить();
