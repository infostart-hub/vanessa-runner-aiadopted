#Использовать "../../src/core/Движки"

Управление = Новый УправляемыйЗапускПредприятия;
Контекст = Новый Структура("Вид, КаталогБазы, ПутьСтатуса", "vanessa", "", "");
Состояние = Управление.Запустить("/usr/bin/true", Контекст);
Пока Состояние.Получить("state") <> "exited" Цикл
    Если Состояние.Получить("state") = "supervision_error" Или Состояние.Получить("state") = "supervision_lost" Тогда
        ВызватьИсключение Строка(Состояние.Получить("observationError"));
    КонецЕсли;
    Состояние = Управление.СледующееСостояние(Состояние.Получить("runId"), Состояние.Получить("observationId"));
КонецЦикла;
Если Состояние.Получить("result") <> "failed" Или Состояние.Получить("scenarioStatus") <> "unknown" Тогда
    ВызватьИсключение "Нулевой код выхода без статуса Vanessa ошибочно признан успехом";
КонецЕсли;
Сообщить("PASS: OneScript macOS observer bridge");
