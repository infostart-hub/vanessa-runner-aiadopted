#Использовать json
#Использовать 1commands

// Общий владелец запусков CLI и MCP. Состояние хранит отдельный наблюдатель Windows или macOS.
Перем _Помощник;

Процедура ПриСозданииОбъекта()
    КаталогКласса = Новый Файл(ТекущийСценарий().Источник).Путь;
    _Помощник = Новый Файл(ОбъединитьПути(КаталогКласса, "../../../../tools/enterprise-window.ps1")).ПолноеИмя;
КонецПроцедуры

Функция Запустить(Знач КоманднаяСтрока, Знач Контекст) Экспорт
    Идентификатор = Строка(Новый УникальныйИдентификатор);
    Заданный = Неопределено;
    Если Контекст.Свойство("Идентификатор", Заданный) Тогда
        Идентификатор = Строка(Новый УникальныйИдентификатор(Заданный));
    КонецЕсли;
    Спецификация = Новый Структура("commandLine, kind, ibpath, statusPath", КоманднаяСтрока,
        Контекст.Вид, Контекст.КаталогБазы, Контекст.ПутьСтатуса);
    Подготовка = Неопределено;
    Если Контекст.Свойство("Подготовка", Подготовка) Тогда
        Спецификация.Вставить("preparationCommandLine", Подготовка);
    КонецЕсли;
    ПодтверждениеЛицензии = Ложь;
    Если Контекст.Свойство("ПодтвердитьЛицензиюРазработчика", ПодтверждениеЛицензии) Тогда
        Спецификация.Вставить("acknowledgeDeveloperLicense", ПодтверждениеЛицензии);
    КонецЕсли;
    Путь = ПолучитьИмяВременногоФайла("json");
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(Путь, "UTF-8");
    ЗаписатьJSON(Запись, Спецификация);
    Запись.Закрыть();
    Попытка
        Результат = Вызвать("launch", Идентификатор, 0, Путь);
    Исключение
        УдалитьФайлы(Путь);
        ВызватьИсключение;
    КонецПопытки;
    УдалитьФайлы(Путь);
    Возврат Результат;
КонецФункции

Функция НайтиПоЖурналу(Знач Путь) Экспорт
    Возврат Вызвать("find", "00000000-0000-0000-0000-000000000000", 0, Путь);
КонецФункции

Функция Состояние(Знач Идентификатор) Экспорт
    Возврат Вызвать("status", Идентификатор, 0);
КонецФункции

// Следующее состояние запуска после названного. Наблюдатель переписывает
// state.json при каждом изменении, и это изменение файла и есть событие:
// ожидание не опрашивает запуск по часам и не знает предельного срока.
Функция СледующееСостояние(Знач Идентификатор, Знач Предыдущее) Экспорт
    Возврат Вызвать("await", Идентификатор, 0, Предыдущее);
КонецФункции

Функция Восстановить(Знач Идентификатор) Экспорт
    Возврат Вызвать("recover", Идентификатор, 0);
КонецФункции

Функция РазрешитьОбработке(Знач Идентификатор, Знач Возможность) Экспорт
    Возврат Вызвать("authorize", Идентификатор, 0, Возможность);
КонецФункции

Функция ВыполнитьПодготовленный(Знач Идентификатор) Экспорт
    Возврат Вызвать("execute", Идентификатор, 0);
КонецФункции

Функция Остановить(Знач Идентификатор, Знач Таймаут) Экспорт
    Возврат Вызвать("stop", Идентификатор, Таймаут);
КонецФункции

Функция Отменить(Знач Идентификатор) Экспорт
    Возврат Вызвать("cancel", Идентификатор, 0);
КонецФункции

Функция Вызвать(Знач Действие, Знач Идентификатор, Знач Таймаут, Знач Спецификация = "")
    // Проверка до формирования аргументов процесса: runId не является произвольной командой/путём.
    Проверенный = Строка(Новый УникальныйИдентификатор(Идентификатор));
    Команда = Новый Команда;
    Если СтрНачинаетсяС(Строка(Новый СистемнаяИнформация().ТипПлатформы), "MacOS") Тогда
        Команда.УстановитьКоманду("python3");
        ПомощникMac = СтрЗаменить(_Помощник, "enterprise-window.ps1", "enterprise-macos.py");
        Команда.ДобавитьПараметр("""" + ПомощникMac + """");
    Иначе
    Команда.УстановитьКоманду("powershell.exe");
    Команда.ДобавитьПараметр("-NoProfile");
    Команда.ДобавитьПараметр("-NonInteractive");
    Команда.ДобавитьПараметр("-WindowStyle");
    Команда.ДобавитьПараметр("Hidden");
    Команда.ДобавитьПараметр("-File");
    Команда.ДобавитьПараметр("""" + _Помощник + """");
    КонецЕсли;
    Команда.ДобавитьПараметр("-Action");
    Команда.ДобавитьПараметр(Действие);
    Команда.ДобавитьПараметр("-RunId");
    Команда.ДобавитьПараметр(Проверенный);
    Команда.ДобавитьПараметр("-TimeoutSeconds");
    Команда.ДобавитьПараметр(Строка(Таймаут));
    Если ЗначениеЗаполнено(Спецификация) Тогда
        Команда.ДобавитьПараметр("-SpecPath");
        Команда.ДобавитьПараметр("""" + Спецификация + """");
    КонецЕсли;
    Команда.УстановитьИсполнениеЧерезКомандыСистемы(Ложь);
    Команда.УстановитьПравильныйКодВозврата(0);
    Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
    Команда.Исполнить();
    Возврат РазобратьСостояние(Команда.ПолучитьВывод());
КонецФункции

// Нативный JSON сохраняет null: отсутствие измерения не равно пустой строке или нулю.
Функция РазобратьСостояние(Знач Текст) Экспорт
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение, Истина);
    Чтение.Закрыть();
    Возврат СохранитьNull(Данные);
КонецФункции

Функция СохранитьNull(Знач Данные)
    Если Данные = Неопределено Тогда Возврат Null; КонецЕсли;
    Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
        Результат = Новый Соответствие;
        Для Каждого КЗ Из Данные Цикл
            Результат.Вставить(КЗ.Ключ, СохранитьNull(КЗ.Значение));
        КонецЦикла;
        Возврат Результат;
    ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Данные Цикл
            Результат.Добавить(СохранитьNull(Элемент));
        КонецЦикла;
        Возврат Результат;
    КонецЕсли;
    Возврат Данные;
КонецФункции
