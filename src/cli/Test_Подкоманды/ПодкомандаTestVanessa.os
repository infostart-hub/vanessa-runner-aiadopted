// BSLLS:LineLength-off
// BSLLS:Typo-off
// BSLLS:MissingVariablesDescription-off Поля &Опция/&Аргумент/&НаборОпций - описания заданы в самой аннотации.
// BSLLS:MissingParameterDescription-off Внутренние служебные методы команды.
// BSLLS:MissingReturnedValueDescription-off Внутренние служебные методы команды.
&Лог("vrunner")
Перем Лог;

&Пластилин
Перем СервисЗаполненияПараметров;

&Пластилин
Перем СервисОкружения;

&Пластилин
Перем ФайловыеОперации;

&Пластилин
Перем СервисVanessaADD;

&Пластилин
Перем СервисПлатформы;

&НаборОпций("НаборОпцийПодключения")
Перем ОпцииПодключения;

&НаборОпций("НаборОпцийПлатформы")
Перем ОпцииПлатформы;

&НаборОпций("НаборОпцийЗапуска")
Перем ОпцииЗапуска;

&НаборОпций("НаборОпцийПокрытия")
Перем ОпцииПокрытия;

&Опция(Имя = "feature-path",
    Описание = "Путь к каталогу с фичами или к фиче. Поддерживается макрос $addRoot - каталог установки vanessa-add")
&ТСтрока
&ВОкружении("VRUNNER_FEATUREPATH")
Перем ПутьКФичам;

&Опция(Имя = "libraries", Описание = "Каталоги библиотек шагов Vanessa Automation. Передаются в КаталогиБиблиотек файла настроек.")
&ТМассивСтрок
Перем КаталогиБиблиотек;

&Опция(Имя = "bddrunner-path", Описание = "Путь к внешней обработке bddRunner.epf (по умолчанию из vanessa-add)")
&ТСтрока
&ВОкружении("VRUNNER_PATHVANESSA")
Перем ПутьКИнструментам;

&Опция(Имя = "vanessasettings",
	Описание = "Путь к настройкам Vanessa; относительный путь и макросы $workspaceRoot/$workspace разрешаются от --workspace")
&ТСтрока
&ВОкружении("VRUNNER_VANESSASETTINGS")
Перем ПутьКНастройкам;

&Опция(Имя = "vanessa-base-settings", Описание = "Базовые настройки установленного стенда Vanessa. Настройки vanessasettings накладываются поверх них; файлы не изменяются.")
&ТСтрока
&ВОкружении("VRUNNER_VANESSA_BASE_SETTINGS")
Перем БазовыеНастройкиVanessa;

&Опция(Имя = "workspace", Описание = "Путь к папке проекта (для макросов $workspace, по умолчанию - текущий)")
&ТСтрока
&ВОкружении("VRUNNER_WORKSPACE")
Перем РабочийКаталогПроекта;

&Опция(Имя = "tags-ignore", Описание = "Теги игнорирования фича-файлов")
&ТСтрока
Перем ТегиИгнорирования;

&Опция(Имя = "tags-filter", Описание = "Теги фильтрации фича-файлов")
&ТСтрока
Перем ТегиФильтр;

&Опция(Имя = "additional-keys", Описание = "Дополнительные параметры, передаваемые в /C")
&ТСтрока
Перем ДопКлючи;

&Опция(Имя = "no-wait", Описание = "Не ожидать завершения запущенной команды/действия")
&Флаговый
Перем НеОжидать;

&Пластилин
Перем ДвижокКонфигуратор;

&Опция(Имя = "run-id", Описание = "UUID собственного запуска, заданный вызывающим владельцем до отправки. Повтор того же UUID запрещает второй запуск; состояние доступно через enterprise_status независимо от логов.")
&ТСтрока
Перем ИдентификаторЗапуска;

&Опция(Имя = "prepare", Описание = "Подготовить окно TestClient без запуска сценариев. После подготовки enterprise_execute запускает сценарии этого же runId.")
&Флаговый
Перем Подготовить;

&Опция(Имя = "acknowledge-developer-license", Описание = "Подтверждать информационное предупреждение лицензии разработчика в собственных процессах управляемого Windows-запуска. Квитанция доступна через enterprise_status.")
&Флаговый
Перем ПодтвердитьЛицензиюРазработчика;

&НаборОпций("НаборОпцийОтчетов")
Перем ОпцииОтчетов;

&НаборОпций("НаборОпцийНастроек")
Перем ОпцииНастроек; // BSLLS:UnusedLocalVariable-off

&ПодкомандаПриложения(Имя = "vanessa", Родитель = "КомандаTest", Описание = "Запустить сценарий Vanessa и получить JUnit/Allure. На настроенном стенде VRUNNER_* достаточно feature-path; базу, платформу, EPF и библиотеки повторно задавать не требуется. Для управляемого запуска задайте run-id до отправки; enterprise_status возвращает структурированную квитанцию. Сценарий и завершение процессов проверяются отдельно.")
&ДоступноВMCP
&MCPДлительная
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ВыполнениеКоманды
Процедура ВыполнитьДействие() Экспорт

	СервисЗаполненияПараметров.Заполнить(ЭтотОбъект);

	КаталогПроекта = Новый Файл(СервисОкружения.ПутьИлиРабочийКаталог(РабочийКаталогПроекта)).ПолноеИмя;

	ПутьКФичам = РазрешитьПутьОтКаталогаПроекта(СервисVanessaADD.ПодставитьМакросAddRoot(ПутьКФичам, "фичам"), КаталогПроекта);
	ПутьКНастройкам = РазрешитьПутьОтКаталогаПроекта(ПутьКНастройкам, КаталогПроекта);
	ПутьКНастройкам = Новый НастройкиVanessa().ДополнитьСценарием(ПутьКНастройкам, ПутьКФичам, КаталогиБиблиотек, КаталогПроекта,
		РазрешитьПутьОтКаталогаПроекта(БазовыеНастройкиVanessa, КаталогПроекта));
	ПутьКНастройкам = ДополнитьНастройкиОтчетами(ПутьКНастройкам);
	НастройкиСценария = Новый НастройкиVanessa();
	Если НЕ ЗначениеЗаполнено(ИдентификаторЗапуска) Тогда
		ИдентификаторТекущегоЗапуска = Строка(Новый УникальныйИдентификатор);
	Иначе
		ИдентификаторТекущегоЗапуска = Строка(Новый УникальныйИдентификатор(ИдентификаторЗапуска));
	КонецЕсли;
	КаталогАртефактов = ОбъединитьПути(КаталогПроекта, "runtime", "runs", ИдентификаторТекущегоЗапуска);
	СтатусЗапуска = Неопределено;
	УправляемыйЗапуск = (СервисОкружения.ЭтоWindows() Или СервисОкружения.ЭтоMacOS())
		И НЕ ОпцииЗапуска.ИспользоватьIbsrv;
	Если НЕ НеОжидать Или УправляемыйЗапуск Тогда
		СтатусЗапуска = НастройкиСценария.ПодготовитьСтатусВыполнения(ПутьКНастройкам, УправляемыйЗапуск И НЕ Подготовить, КаталогАртефактов);
		ПутьКНастройкам = СтатусЗапуска.ПутьНастроек;
		Лог.Информация("Файл статуса текущего запуска Vanessa: %1", СтатусЗапуска.ПутьСтатуса);
	КонецЕсли;
	УстановитьПутьКФичамДляVanessa();

	Лог.Информация("Тестирую поведение с помощью фреймворка Vanessa-ADD (BDD)");

	ПараметрыПлатформы = ОпцииПлатформы.СформироватьПараметрыПлатформы();
	ПараметрыПодключения = ОпцииПодключения.ПараметрыПодключения();

	ПутьКОбработке = СервисVanessaADD.ПутьКОбработке("bddRunner.epf", ПутьКИнструментам, "--bddrunner-path");
	КлючЗапуска = СформироватьКлючЗапуска(КаталогПроекта);

	ПараметрыЗапуска = СервисПлатформы.НовыеПараметрыЗапуска(КлючЗапуска, ПутьКОбработке);
	ПараметрыЗапуска.НеОжидать = НеОжидать;
	ОпцииЗапуска.ДополнитьПараметрыЗапуска(ПараметрыЗапуска, "/TESTMANAGER");

	Если Подготовить И (НЕ УправляемыйЗапуск Или НЕ НеОжидать Или НЕ СервисОкружения.ЭтоWindows()) Тогда
		ВызватьИсключение "--prepare требует управляемый Windows-запуск и --no-wait";
	КонецЕсли;
	Если ПодтвердитьЛицензиюРазработчика И (НЕ УправляемыйЗапуск Или НЕ СервисОкружения.ЭтоWindows()) Тогда
		ВызватьИсключение "--acknowledge-developer-license требует управляемый Windows-запуск";
	КонецЕсли;
	Если УправляемыйЗапуск Тогда
		КонтрольЗапуска = Новый Структура("Вид, КаталогБазы, ПутьСтатуса", "vanessa", "", СтатусЗапуска.ПутьСтатуса);
		Если ЗначениеЗаполнено(ИдентификаторТекущегоЗапуска) Тогда
			КонтрольЗапуска.Вставить("Идентификатор", ИдентификаторТекущегоЗапуска);
		КонецЕсли;
		КонтрольЗапуска.Вставить("ПодтвердитьЛицензиюРазработчика", ПодтвердитьЛицензиюРазработчика);
		Если Подготовить Тогда
			Клиент = НастройкиСценария.ПодготовитьКлиентаТестирования(ПутьКНастройкам);
			ПланКлиента = ДвижокКонфигуратор.СформироватьЗапускПредприятия(
				Клиент.Подключение, Клиент.Запуск, ПараметрыПлатформы);
			КонтрольЗапуска.Вставить("Подготовка", ПланКлиента.КоманднаяСтрока);
		КонецЕсли;
		ПараметрыЗапуска.Вставить("КонтрольЗапускаVanessa", КонтрольЗапуска);
	КонецЕсли;

	СервисПлатформы.ЗапуститьПредприятие(ПараметрыПодключения, ПараметрыЗапуска, ПараметрыПлатформы,
		ОпцииПокрытия.ПараметрыЕслиВключено());
	Если СтатусЗапуска <> Неопределено И НЕ НеОжидать Тогда
		НастройкиСценария.ПроверитьСтатусВыполнения(СтатусЗапуска.ПутьСтатуса);
	КонецЕсли;

	Если НеОжидать Тогда
		Лог.Информация("Vanessa запущена без ожидания; результат сценариев ещё не проверен");
	Иначе
		Лог.Информация("Тестирование поведения завершено успешно; статус Vanessa: 0");
	КонецЕсли;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Передать путь к фичам в Vanessa-ADD через переменную окружения VANESSA_FEATUREPATH.
// Ключа запуска для пути к фичам у bddRunner нет - переменная окружения наследуется
// клиентом 1С и переопределяет КаталогФич из настроек (поведение 2.x).
Процедура УстановитьПутьКФичамДляVanessa()

	Если НЕ ЗначениеЗаполнено(ПутьКФичам) Тогда
		Возврат;
	КонецЕсли;

	Если ОпцииЗапуска.ТолстыйКлиент = Истина Тогда
		ВызватьИсключение "Нельзя одновременно указывать --ordinaryapp и --feature-path:"
			+ " Vanessa-ADD в толстом клиенте (обычные формы) не поддерживает указание фич при запуске.";
	КонецЕсли;

	ПутьКФичам = Новый Файл(ПутьКФичам).ПолноеИмя;
	УстановитьПеременнуюСреды("VANESSA_FEATUREPATH", ПутьКФичам);
	Лог.Отладка("VANESSA_FEATUREPATH = %1", ПутьКФичам);

КонецПроцедуры

// Форматы отчёта Vanessa-ADD. Отчёты пишет сама Vanessa-ADD, набор форматов задан
// её настройками (см. behavior-schema.json), поэтому словарь закрыт.
// Значение - имя каталога внутри --report-path, когда форматов несколько.
Функция ДопустимыеФорматыОтчетов()

	Форматы = Новый Соответствие;
	Форматы.Вставить("junit", "junit");
	Форматы.Вставить("allure", "allure");
	Форматы.Вставить("cucumberjson", "cucumber");

	Возврат Форматы;

КонецФункции

// Наложить --report-format/--report-path на настройки Vanessa-ADD: ключей запуска для отчётов
// у bddRunner нет, поэтому опции дописываются в копию пользовательского файла настроек и
// перекрывают одноимённые настройки (иначе опция была бы бесполезна при --vanessasettings).
// Возвращает путь к файлу настроек для ключа VBParams.
Функция ДополнитьНастройкиОтчетами(Знач ПутьНастроек)

	// У Vanessa-ADD все форматы выгружаются в каталог, поэтому путь обязателен - это проверяет Отчеты.
	Отчеты = ОпцииОтчетов.Отчеты(ДопустимыеФорматыОтчетов(), "junit");
	Если Отчеты.Количество() = 0 Тогда
		Возврат ПутьНастроек;
	КонецЕсли;

	Для Каждого Отчет Из Отчеты Цикл
		Лог.Информация("Отчёт Vanessa в формате %1: %2", Отчет.Формат, Отчет.Путь);
		ФайловыеОперации.ОбеспечитьКаталог(Отчет.Путь);
	КонецЦикла;

	Возврат Новый НастройкиVanessa().ДополнитьОтчетами(ПутьНастроек, Отчеты);

КонецФункции

Функция СформироватьКлючЗапуска(Знач КаталогПроекта)

	КлючиЗапуска = Новый Массив;
	КлючиЗапуска.Добавить("StartFeaturePlayer");
	КлючиЗапуска.Добавить("workspaceRoot=" + КаталогПроекта);

	Если ЗначениеЗаполнено(ПутьКНастройкам) Тогда
		КлючиЗапуска.Добавить("VBParams=" + ПутьКНастройкам);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТегиИгнорирования) Тогда
		КлючиЗапуска.Добавить("TagsIgnore=" + ТегиИгнорирования);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТегиФильтр) Тогда
		КлючиЗапуска.Добавить("TagsFilter=" + ТегиФильтр);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДопКлючи) Тогда
		КлючиЗапуска.Добавить(ДопКлючи);
	КонецЕсли;

	Возврат СтрСоединить(КлючиЗапуска, ";");

КонецФункции

// Относительный путь к настройкам Vanessa разрешается от каталога проекта, а не от каталога
// установки vanessa-add, где bddRunner обрабатывает VBParams; макросы $workspaceRoot/$workspace - туда же.
Функция РазрешитьПутьОтКаталогаПроекта(Знач Путь, Знач КаталогПроекта)

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Путь = СтрЗаменить(Путь, "$workspaceRoot", КаталогПроекта);
	Путь = СтрЗаменить(Путь, "$workspace", КаталогПроекта);

	Возврат Новый Файл(ОбъединитьПути(КаталогПроекта, Путь)).ПолноеИмя;

КонецФункции


#КонецОбласти
