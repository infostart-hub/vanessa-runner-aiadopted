// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// BSLLS:LatinAndCyrillicSymbolInWord-off Технические имена настроек Vanessa-ADD (КаталогOutputjUnit и т.п.).
// Сборка файла настроек Vanessa-ADD (ключ запуска VBParams) с параметрами выгрузки отчётов.
//
// У bddRunner нет ключей запуска для отчётов: форматы и каталоги задаются только
// настройками (см. behavior-schema.json в корне репозитория). Поэтому значения опций
// --report-format / --report-path vrunner накладывает поверх пользовательских настроек
// и передаёт в 1С уже временный файл. Прецедент тот же, что у YAxUnit: конфигурационный
// файл фреймворка собирает сам vrunner.
//
// Пользовательские настройки при этом не переписываются - временный файл создаётся рядом,
// а исходный остаётся нетронутым.

// Значения булевых настроек Vanessa-ADD - строки "Истина"/"Ложь", а не JSON-литералы.
Перем _Истина; // Строка - значение включённой настройки
Перем _Ложь;   // Строка - значение выключенной настройки

Процедура ПриСозданииОбъекта()

	_Истина = "Истина";
	_Ложь = "Ложь";

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Дополнить настройки Vanessa-ADD параметрами выгрузки отчётов.
//
// Параметры:
//   ПутьНастроек - Строка - путь к пользовательскому файлу настроек; может быть пустым
//   Отчеты       - Массив - Элементы <Структура> с полями Формат и Путь
//
// Возвращаемое значение:
//   Строка - путь к файлу настроек для ключа VBParams: исходный, если отчёты не заданы,
//            иначе временный файл с наложенными настройками
//
Функция ДополнитьОтчетами(Знач ПутьНастроек, Знач Отчеты) Экспорт

	Если Отчеты = Неопределено ИЛИ Отчеты.Количество() = 0 Тогда
		Возврат ПутьНастроек;
	КонецЕсли;

	Настройки = ПрочитатьНастройки(ПутьНастроек);

	Для Каждого Отчет Из Отчеты Цикл
		ПрименитьОтчет(Настройки, Отчет);
	КонецЦикла;

	Возврат ЗаписатьВременныеНастройки(Настройки);

КонецФункции

// CLI feature-path работает и для Automation, которая не читает VANESSA_FEATUREPATH.
Функция ДополнитьСценарием(Знач ПутьНастроек, Знач ПутьФичи, Знач Библиотеки, Знач РабочийКаталог, Знач БазовыйПуть = "") Экспорт
    Если НЕ ЗначениеЗаполнено(БазовыйПуть) И НЕ ЗначениеЗаполнено(ПутьФичи) И (Библиотеки = Неопределено Или Библиотеки.Количество() = 0) Тогда
        Возврат ПутьНастроек;
    КонецЕсли;
    Настройки = ПрочитатьНастройки(БазовыйПуть);
    Для Каждого Пара Из ПрочитатьНастройки(ПутьНастроек) Цикл
        Настройки.Вставить(Пара.Ключ, Пара.Значение);
    КонецЦикла;
    Если ЗначениеЗаполнено(ПутьФичи) Тогда
        ПутьФичи = ОбъединитьПути(РабочийКаталог, ПутьФичи);
        Если НЕ Новый Файл(ПутьФичи).Существует() Тогда
            ВызватьИсключение "Feature не найден: " + ПутьФичи;
        КонецЕсли;
        Настройки.Вставить("КаталогФич", Новый Файл(ПутьФичи).ПолноеИмя);
    КонецЕсли;
    Если Библиотеки <> Неопределено И Библиотеки.Количество() > 0 Тогда
        Пути = Новый Массив;
        Для Каждого Библиотека Из Библиотеки Цикл
            Библиотека = ОбъединитьПути(РабочийКаталог, Библиотека);
            Если НЕ Новый Файл(Библиотека).Существует() Тогда
                ВызватьИсключение "Библиотека шагов не найдена: " + Библиотека;
            КонецЕсли;
            Пути.Добавить(Новый Файл(Библиотека).ПолноеИмя);
        КонецЦикла;
        Настройки.Вставить("КаталогиБиблиотек", Пути);
    КонецЕсли;
    Возврат ЗаписатьВременныеНастройки(Настройки);
КонецФункции

// Подготовить отдельный статус этого запуска: старый файл не доказывает успех.
Функция ПодготовитьСтатусВыполнения(Знач ПутьНастроек, Знач Автоматический = Ложь, Знач КаталогАртефактов = "") Экспорт

	Настройки = ПрочитатьНастройки(ПутьНастроек);
	ИмяФлага = "ВыгружатьСтатусВыполненияСценариевВФайл";
	// Vanessa-ADD использует строки, Vanessa Automation также принимает JSON boolean.
	ЗначениеФлага = ?(ТипЗнч(Настройки[ИмяФлага]) = Тип("Булево"), Истина, _Истина);
	Настройки.Вставить(ИмяФлага, ЗначениеФлага);
    // An external owner requires a machine verdict. Interactive pause on error
    // otherwise leaves a live TestClient and no terminal scenario receipt.
    Если Автоматический Тогда
        Настройки.Вставить("ВыполнитьСценарии", Истина);
        Пауза = Настройки.Получить("ОстановкаПриВозникновенииОшибки");
        Настройки.Вставить("ОстановкаПриВозникновенииОшибки", ?(ТипЗнч(Пауза) = Тип("Булево"), Ложь, _Ложь));
        // The framework closes its clients after reports; the native owner
        // confirms actual group exit. No external GUI close is a test verdict.
        Для Каждого ИмяЗавершения Из СтрРазделить("ЗавершитьРаботуСистемы,ЗакрытьTestClientПослеЗапускаСценариев", ",") Цикл
            Текущее = Настройки.Получить(ИмяЗавершения);
            Настройки.Вставить(ИмяЗавершения, ?(ТипЗнч(Текущее) = Тип("Булево"), Истина, _Истина));
        КонецЦикла;
    КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КаталогАртефактов) Тогда
		КаталогАртефактов = ОбъединитьПути(Новый Файл(ПутьНастроек).Путь, "runs", Строка(Новый УникальныйИдентификатор));
	КонецЕсли;
	КаталогАртефактов = Новый Файл(КаталогАртефактов).ПолноеИмя;
	ПутьСтатуса = ОбъединитьПути(КаталогАртефактов, "scenario.status");
	ПутьФактическихНастроек = ОбъединитьПути(КаталогАртефактов, "vanessa-effective.json");
	Если Новый Файл(ПутьСтатуса).Существует() Или Новый Файл(ПутьФактическихНастроек).Существует() Тогда
		ВызватьИсключение "Артефакты запуска уже существуют: " + КаталогАртефактов;
	КонецЕсли;
	СоздатьКаталог(КаталогАртефактов);
    Если Автоматический Тогда
        // A managed test produces inspectable evidence even if only feature-path was supplied.
        Для Каждого Формат Из СтрРазделить("junit,allure", ",") Цикл
            Флаг = ?(Формат = "junit", "ДелатьОтчетВФорматеjUnit", "ДелатьОтчетВФорматеАллюр");
            Поле = ?(Формат = "junit", "КаталогOutputjUnit", "КаталогOutputAllureБазовый");
            Если Настройки.Получить(Флаг) = Неопределено Тогда Настройки.Вставить(Флаг, Истина); КонецЕсли;
            Если НЕ ЗначениеЗаполнено(Настройки.Получить(Поле)) Тогда
                Настройки.Вставить(Поле, ОбъединитьПути(КаталогАртефактов, Формат));
            КонецЕсли;
            СоздатьКаталог(Настройки.Получить(Поле));
        КонецЦикла;
        Если Настройки.Получить("СоздаватьПодкаталогВКаталогеAllureДляЭтойСборки") = Неопределено Тогда
            Настройки.Вставить("СоздаватьПодкаталогВКаталогеAllureДляЭтойСборки", Ложь);
        КонецЕсли;
    КонецЕсли;
	КаталогРаботы = Настройки.Получить("КаталогВременныхФайлов");
	Если КаталогРаботы <> Неопределено И ЗначениеЗаполнено(КаталогРаботы) Тогда
		Если ТипЗнч(КаталогРаботы) <> Тип("Строка") Тогда
			ВызватьИсключение "КаталогВременныхФайлов должен быть строкой";
		КонецЕсли;
		КаталогРаботы = Новый Файл(КаталогРаботы).ПолноеИмя;
		СоздатьКаталог(КаталогРаботы);
		Настройки.Вставить("КаталогВременныхФайлов", КаталогРаботы);
	КонецЕсли;
	Настройки.Вставить("ПутьКФайлуДляВыгрузкиСтатусаВыполненияСценариев", ПутьСтатуса);
	Возврат Новый Структура("ПутьНастроек, ПутьСтатуса",
		ЗаписатьНастройки(Настройки, ПутьФактическихНастроек), ПутьСтатуса);

КонецФункции

// Профиль окна принадлежит настройкам Vanessa, не графу и не записывателю.
Функция ПодготовитьКлиентаТестирования(Знач ПутьНастроек) Экспорт
	Настройки = ПрочитатьНастройки(ПутьНастроек);
	Профили = Настройки.Получить("КлиентыТестирования");
	Если ТипЗнч(Профили) <> Тип("Массив") Тогда
		ВызватьИсключение "Подготовка окна требует КлиентыТестирования в настройках Vanessa";
	КонецЕсли;
	Активные = Новый Массив;
	Для Каждого Профиль Из Профили Цикл
		Если Профиль.Получить("АктивизироватьСтроку") = Истина Или Профиль.Получить("АктивизироватьСтроку") = "Истина" Тогда
			Активные.Добавить(Профиль);
		КонецЕсли;
	КонецЦикла;
	Если Активные.Количество() <> 1 Тогда
		ВызватьИсключение "Подготовка окна требует ровно один активный профиль TestClient";
	КонецЕсли;
	Профиль = Активные[0];
	Если Профиль.Получить("ТипКлиента") <> "Тонкий" Тогда
		ВызватьИсключение "Подготовка окна поддерживает профиль тонкого TestClient";
	КонецЕсли;
	Если Профиль.Получить("ИмяКомпьютера") <> "localhost" И Профиль.Получить("ИмяКомпьютера") <> "127.0.0.1" Тогда
		ВызватьИсключение "Подготовка окна требует локальный профиль TestClient";
	КонецЕсли;
	Порт = Профиль.Получить("ПортЗапускаТестКлиента");
	Если ТипЗнч(Порт) <> Тип("Число") Или Порт < 1 Или Порт > 65535 Или Цел(Порт) <> Порт Тогда
		ВызватьИсключение "Профиль TestClient требует порт от 1 до 65535";
	КонецЕсли;
	База = Профиль.Получить("ПутьКИнфобазе");
	Если ТипЗнч(База) <> Тип("Строка") Или НЕ ЗначениеЗаполнено(База) Тогда
		ВызватьИсключение "Профиль TestClient требует ПутьКИнфобазе";
	КонецЕсли;
	Подключение = Новый Структура("СтрокаПодключения, Пользователь, Пароль", База,
		СтроковоеПолеПрофиля(Профиль, "ИмяПользователя"), СтроковоеПолеПрофиля(Профиль, "Пароль"));
	ДопПараметры = "/TESTCLIENT -TPort " + Формат(Порт, "ЧГ=0") + " " + СтроковоеПолеПрофиля(Профиль, "ДопПараметры");
	Запуск = Новый Структура("НеОжидать, РежимЗапуска, КомандаЗапуска, ПутьКФайлуСтатуса, ПутьОбработки, НавигационнаяСсылка, ДополнительныеПараметры",
		Истина, "0", "", "", "", "", ДопПараметры);
	Возврат Новый Структура("Подключение, Запуск", Подключение, Запуск);
КонецФункции

Функция СтроковоеПолеПрофиля(Профиль, Знач Имя)
	Значение = Профиль.Получить(Имя);
	Если Значение = Неопределено Тогда Возврат ""; КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда ВызватьИсключение "Требуется строка профиля: " + Имя; КонецЕсли;
	Возврат Значение;
КонецФункции

// Успех процесса 1С сам по себе не подтверждает успех сценария.
Процедура ПроверитьСтатусВыполнения(Знач ПутьСтатуса) Экспорт

	Если НЕ Новый Файл(ПутьСтатуса).Существует() Тогда
		ВызватьИсключение "Vanessa не записала статус выполнения: " + ПутьСтатуса;
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(ПутьСтатуса, "UTF-8");
	Статус = СокрЛП(Чтение.Прочитать());
	Чтение.Закрыть();
	Если Статус <> "0" Тогда
		ВызватьИсключение СтрШаблон("Сценарии Vanessa не завершились успешно. Статус: %1; файл: %2",
			Статус, ПутьСтатуса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьНастройки(Знач ПутьНастроек)

	Если НЕ ЗначениеЗаполнено(ПутьНастроек) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Файл = Новый Файл(ПутьНастроек);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Файл настроек Vanessa не найден: %1", ПутьНастроек);
	КонецЕсли;

	Данные = Новый ОперацииJSON().Прочитать(Файл.ПолноеИмя);

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение СтрШаблон(
			"Файл настроек Vanessa должен содержать объект JSON: %1", ПутьНастроек);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Процедура ПрименитьОтчет(Настройки, Знач Отчет)

	Если Отчет.Формат = "junit" Тогда

		Настройки.Вставить("ДелатьОтчетВФорматеjUnit", _Истина);
		Настройки.Вставить("КаталогOutputjUnit", Отчет.Путь);

	ИначеЕсли Отчет.Формат = "cucumberjson" Тогда

		Настройки.Вставить("ДелатьОтчетВФорматеCucumberJson", _Истина);
		Настройки.Вставить("КаталогOutputCucumberJson", Отчет.Путь);

	ИначеЕсли Отчет.Формат = "allure" Тогда

		// Vanessa Automation требует флаг; Vanessa-ADD включает отчёт по каталогу.
		Настройки.Вставить("ДелатьОтчетВФорматеАллюр", Истина);
		// Подкаталог сборки выключаем: иначе результат уезжает в непредсказуемый путь,
		// и CI не знает, что публиковать.
		Настройки.Вставить("КаталогOutputAllureБазовый", Отчет.Путь);
		Настройки.Вставить("КаталогOutputAllure", Отчет.Путь);
		Настройки.Вставить("СоздаватьПодкаталогВКаталогеAllureДляЭтойСборки", _Ложь);

	Иначе

		ВызватьИсключение СтрШаблон("Неизвестный формат отчёта Vanessa: %1", Отчет.Формат);

	КонецЕсли;

КонецПроцедуры

Функция ЗаписатьВременныеНастройки(Знач Настройки)

	// BSLLS:MissingTemporaryFileDeletion-off файл читает 1С при запуске, удаляется ОС
	ПутьФайла = ПолучитьИмяВременногоФайла("json");
	// BSLLS:MissingTemporaryFileDeletion-on
	Возврат ЗаписатьНастройки(Настройки, ПутьФайла);
КонецФункции

Функция ЗаписатьНастройки(Знач Настройки, Знач ПутьФайла)
	ОперацииJSON = Новый ОперацииJSON;
	ОперацииJSON.Записать(ПутьФайла, Настройки);

	Возврат ПутьФайла;

КонецФункции

#КонецОбласти
