// BSLLS:UnusedLocalMethod-off ПриСозданииОбъекта вызывается рантаймом при Новый.
// Строка подключения к ИБ: файловая (/F"каталог" или File="каталог"),
// серверная (/S"сервер\база" или Srvr="сервер";Ref="база"),
// веб / автономный сервер ibsrv (/WS"http://..." или ws="http://..." или голый http(s)://...).
// Голый путь без префикса считается каталогом файловой базы - так строку принимает ibcmd.

Перем _Строка; // Строка - строка подключения без пробелов по краям

Процедура ПриСозданииОбъекта(Знач СтрокаПодключения)

	_Строка = СокрЛП(СтрокаПодключения);

КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Возвращаемое значение:
//   Булево - строка подключения файловой ИБ с префиксом /F (без учёта регистра)
//
Функция ЭтоФайловая() Экспорт
	Возврат СтрНачинаетсяС(ВРег(_Строка), "/F");
КонецФункции

// Возвращаемое значение:
//   Булево - строка подключения серверной ИБ (/S или Srvr=, без учёта регистра)
//
Функция ЭтоСерверная() Экспорт
	Верх = ВРег(_Строка);
	Возврат СтрНачинаетсяС(Верх, "/S") Или СтрНачинаетсяС(Верх, "SRVR=");
КонецФункции

// Возвращаемое значение:
//   Булево - веб-публикация или HTTP-адрес автономного сервера ibsrv (/WS, ws=, http://, https://)
//
Функция ЭтоВеб() Экспорт
	Верх = ВРег(_Строка);
	Возврат СтрНачинаетсяС(Верх, "/WS")
		Или СтрНачинаетсяС(Верх, "WS=")
		Или СтрНачинаетсяС(Верх, "HTTP://")
		Или СтрНачинаетсяС(Верх, "HTTPS://");
КонецФункции

// Каталог файловой ИБ: путь после /F или File= либо голый путь без префикса - без кавычек, полный.
//
// Возвращаемое значение:
//   Строка - полный путь к каталогу файловой ИБ; пусто - серверная (/S, Srvr=), веб (/WS, ws=, http), пустая строка
//
Функция КаталогФайловойБазы() Экспорт

	Если ЭтоСерверная() Или ЭтоВеб() Тогда
		Возврат "";
	КонецЕсли;

	Верх = ВРег(_Строка);
	Если СтрНачинаетсяС(Верх, "FILE=") Тогда
		Путь = ИзвлечьПараметрV8i(_Строка, "File");
	ИначеЕсли СтрНачинаетсяС(Верх, "/F") Тогда
		Путь = Сред(_Строка, СтрДлина("/F") + 1);
	Иначе
		Путь = _Строка;
	КонецЕсли;
	Путь = СокрЛП(СтрЗаменить(Путь, """", ""));
	Если Прав(Путь, 1) = ";" Тогда
		Путь = СокрЛП(Лев(Путь, СтрДлина(Путь) - 1));
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Путь), Новый Файл(Путь).ПолноеИмя, "");

КонецФункции

// Адрес веб-публикации / автономного сервера ibsrv (http://... или https://...) без обёртки /WS и кавычек.
//
// Возвращаемое значение:
//   Строка - URL публикации; пусто, если строка не веб-формата
//
Функция АдресВебСервера() Экспорт

	Если НЕ ЭтоВеб() Тогда
		Возврат "";
	КонецЕсли;

	Верх = ВРег(_Строка);
	Если СтрНачинаетсяС(Верх, "WS=") Тогда
		Адрес = ИзвлечьПараметрV8i(_Строка, "ws");
	ИначеЕсли СтрНачинаетсяС(Верх, "/WS") Тогда
		Адрес = Сред(_Строка, СтрДлина("/WS") + 1);
	Иначе
		Адрес = _Строка;
	КонецЕсли;
	Адрес = СокрЛП(СтрЗаменить(Адрес, """", ""));
	Если Прав(Адрес, 1) = ";" Тогда
		Адрес = СокрЛП(Лев(Адрес, СтрДлина(Адрес) - 1));
	КонецЕсли;
	Возврат Адрес;

КонецФункции

// Нормализовать строку подключения (в т.ч. из ibases.v8i или URL автономного сервера EDT/ibsrv)
// к аргументу командной строки платформы 1С (/F"...", /S"...", /WS"...").
// Голый путь без префикса не оборачивается в /F (сохраняется совместимость с ibcmd).
//
// Возвращаемое значение:
//   Строка
//
Функция НормализоватьДляПлатформы() Экспорт

	Если ЭтоВеб() Тогда
		Адрес = АдресВебСервера();
		Возврат ?(ЗначениеЗаполнено(Адрес), "/WS""" + Адрес + """", _Строка);
	КонецЕсли;

	Верх = ВРег(_Строка);
	Если СтрНачинаетсяС(Верх, "SRVR=") Тогда
		Сервер = ИзвлечьПараметрV8i(_Строка, "Srvr");
		База = ИзвлечьПараметрV8i(_Строка, "Ref");
		Если ЗначениеЗаполнено(Сервер) И ЗначениеЗаполнено(База) Тогда
			Возврат "/S""" + Сервер + "\" + База + """";
		КонецЕсли;
		Возврат _Строка;
	КонецЕсли;

	Если ЭтоФайловая() Или СтрНачинаетсяС(Верх, "FILE=") Тогда
		Путь = КаталогФайловойБазы();
		Возврат ?(ЗначениеЗаполнено(Путь), "/F""" + Путь + """", _Строка);
	КонецЕсли;

	Возврат _Строка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзвлечьПараметрV8i(Знач Источник, Знач ИмяКлюча)

	Части = СтрРазделить(Источник, ";", Ложь);
	ИскомыйПрефикс = ВРег(ИмяКлюча) + "=";
	Для Каждого Часть Из Части Цикл
		Очищенная = СокрЛП(Часть);
		Если СтрНачинаетсяС(ВРег(Очищенная), ИскомыйПрефикс) Тогда
			Значение = СокрЛП(Сред(Очищенная, СтрДлина(ИскомыйПрефикс) + 1));
			Возврат СокрЛП(СтрЗаменить(Значение, """", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
